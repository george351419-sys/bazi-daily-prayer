.tabs{position:fixed;bottom:0;left:0;right:0;display:flex;background:#f6f1e7;border-top:1rpx solid #dcd7cb;padding:12rpx 22rpx calc(12rpx + env(safe-area-inset-bottom));z-index:20}.tab{flex:1;background:transparent;color:#8b877b;font-size:24rpx;line-height:64rpx;border-radius:0;padding:0 4rpx;position:relative;white-space:nowrap}.active{color:#415b48;font-weight:600}.mark{height:4rpx;width:30rpx;position:absolute;bottom:4rpx;left:50%;margin-left:-15rpx;background:#a44b3f}

:host{position:fixed;left:0;right:0;bottom:0;z-index:100}.tabs{box-sizing:border-box}.tab::after{border:0}
