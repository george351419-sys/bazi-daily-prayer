.tabs{position:fixed;bottom:0;left:0;right:0;display:flex;background:#fffaf0;border-top:1rpx solid #dcd7cb;padding:10rpx 18rpx calc(10rpx + env(safe-area-inset-bottom));z-index:20;box-shadow:0 -10rpx 30rpx rgba(65,91,72,.06)}.tab{flex:1;background:transparent;color:#8b877b;font-size:22rpx;line-height:1.25;border-radius:10rpx;padding:8rpx 2rpx 12rpx;position:relative;white-space:nowrap;display:flex;flex-direction:column;align-items:center;gap:3rpx}.tab-no{font-family:Georgia,serif;font-size:16rpx;letter-spacing:1rpx;color:#b3a894}.tab-text{font-size:22rpx;white-space:nowrap}.active{color:#415b48;font-weight:600;background:#f0f3e8}.active .tab-no{color:#a44b3f}.mark{height:4rpx;width:28rpx;position:absolute;bottom:4rpx;left:50%;margin-left:-14rpx;background:#a44b3f;border-radius:4rpx}

:host{position:fixed;left:0;right:0;bottom:0;z-index:100}.tabs{box-sizing:border-box}.tab::after{border:0}
