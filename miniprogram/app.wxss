page{background:#f6f1e7;color:#272e28;font-family:"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.7}view,text,input,picker,textarea,button{box-sizing:border-box}button{font:inherit;margin:0;border-radius:12rpx}button::after{border:0}button[disabled]{opacity:.45}.page{padding:32rpx 36rpx 180rpx}.kicker{font-size:21rpx;letter-spacing:5rpx;color:#8b877b}.title{display:block;font-family:"Songti SC","Noto Serif CJK SC",serif;font-size:52rpx;line-height:1.35;margin:12rpx 0 20rpx;font-weight:600}.subtitle,.muted{color:#716e64;font-size:25rpx}.paper{background:#fffcf5;border:1rpx solid #dcd7cb;padding:30rpx;margin:28rpx 0}.section-title{font-family:"Songti SC",serif;font-size:34rpx;display:block;margin-bottom:20rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.stack{display:flex;flex-direction:column;gap:18rpx}.primary,.secondary{padding:20rpx 26rpx;line-height:1.5;min-height:88rpx;font-size:28rpx}.primary{background:#415b48;color:#fffdf6}.secondary{background:transparent;border:1rpx solid #bebdb0;color:#415b48}.text-button{background:transparent;color:#415b48;padding:10rpx 0;text-align:left;font-size:26rpx;line-height:1.5}.label{display:block;font-size:24rpx;color:#716e64;margin:22rpx 0 8rpx}.field{width:100%;background:#f6f1e7;border:1rpx solid #dcd7cb;border-radius:8rpx;min-height:86rpx;padding:16rpx 20rpx;color:#272e28}.note{font-size:23rpx;color:#716e64;display:block;margin-top:16rpx}.notice{font-size:24rpx;color:#7c4938;background:#efe6d8;border-left:4rpx solid #a44b3f;padding:20rpx;margin:22rpx 0}.error{color:#9b3f35;white-space:pre-wrap}.badge{font-size:21rpx;color:#415b48;border:1rpx solid #b9c1b0;padding:4rpx 12rpx;white-space:nowrap}.rule{height:1rpx;background:#dcd7cb;margin:32rpx 0}.choice-row{display:flex;gap:16rpx;margin:18rpx 0}.choice{flex:1;padding:20rpx 12rpx;background:transparent;border:1rpx solid #c5c5b7;color:#716e64;text-align:left;font-size:25rpx;line-height:1.6}.choice.selected{border-color:#415b48;background:#e9ecdf;color:#334a3a}.spaced{margin-top:26rpx}.check-row{display:flex;align-items:center;justify-content:space-between;padding:18rpx 0}.privacy{padding:30rpx;background:#efe6d8;margin-top:26rpx}.pill{display:inline-block;border:1rpx solid #ccc8ba;padding:8rpx 15rpx;border-radius:5rpx;font-size:24rpx;margin:6rpx 10rpx 6rpx 0}.pill.selected{background:#415b48;color:#fffdf6;border-color:#415b48}.empty{text-align:left;padding:50rpx 30rpx;border:1rpx dashed #bcbcad;color:#716e64}.date{font-family:Georgia,serif;font-size:28rpx;color:#716e64}.loading{color:#716e64;padding:15rpx 0}.wide{width:100%}.companion-section{border-top:4rpx solid #415b48}.companion-title{display:block;font-family:"Songti SC",serif;font-size:38rpx;line-height:1.45;color:#334a3a;margin:8rpx 0 14rpx}.companion-lead{display:block;font-family:"Songti SC",serif;font-size:30rpx;line-height:1.9;color:#4f5e50;margin:8rpx 0}.companion-quote{display:block;font-family:"Songti SC",serif;font-size:40rpx;line-height:1.65;color:#334a3a;margin:16rpx 0}.companion-blessing{display:block;font-family:"Songti SC",serif;font-size:34rpx;line-height:1.8;color:#415b48;border-top:1rpx solid #dcd7cb;border-bottom:1rpx solid #dcd7cb;padding:24rpx 0;margin:24rpx 0}.element-list{margin:20rpx 0}.element-row{display:flex;gap:16rpx;padding:18rpx 0;border-bottom:1rpx solid #e4dfd2}.element-no{font-family:Georgia,serif;color:#a58c5d;min-width:42rpx}.element-name{display:block;font-family:"Songti SC",serif;font-size:29rpx;color:#334a3a}.element-meaning{display:block;font-size:25rpx;color:#716e64;margin-top:4rpx}.insight-row{display:flex;gap:16rpx;padding:22rpx 0;border-top:1rpx solid #e4dfd2}.insight-row .section-title{font-size:29rpx;margin-bottom:8rpx}.insight-no{font-family:Georgia,serif;color:#a58c5d;min-width:42rpx}.answer-number{padding:26rpx;border:1rpx solid #d9d3c4;border-left:8rpx solid #415b48;background:#fff;margin:8rpx 0 24rpx}.answer-meta{display:flex;gap:16rpx;align-items:center;font-size:23rpx;color:#