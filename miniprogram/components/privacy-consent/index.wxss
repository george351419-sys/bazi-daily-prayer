.mask{position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center}.dialog{width:82%;padding:40rpx;background:#fffcf5;border-radius:16rpx;color:#272e28;font-size:28rpx;line-height:1.8}.heading{display:block;font-size:36rpx;font-weight:600;margin-bottom:20rpx}button{font-size:28rpx;margin-top:20rpx}.contract,.reject{background:transparent;color:#415b48}.agree{background:#415b48;color:#fff}
