.artwork{position:relative;margin:30rpx 0 16rpx;aspect-ratio:2/3;height:calc((100vw - 72rpx)*1.5);max-height:1000rpx;background:#fffaf0;border:1rpx solid #ccc5b4;overflow:hidden}.painting{width:100%;height:100%;position:absolute}.art-title{position:absolute;top:30rpx;left:28rpx;writing-mode:vertical-rl;letter-spacing:9rpx;font-size:25rpx;font-family:"Songti SC",serif}.seal{position:absolute;right:26rpx;top:30rpx;width:50rpx;height:56rpx;border:2rpx solid #a44b3f;color:#a44b3f;text-align:center;line-height:50rpx;font-family:"Songti SC",serif;font-size:34rpx}.art-action{position:absolute;bottom:0;left:0;right:0;padding:26rpx 28rpx 32rpx;background:rgba(255,250,240,.95);border-top:1rpx solid #d2cdbf}.action-label{display:block;font-size:22rpx;letter-spacing:3rpx;color:#716e64}.action-text{font-family:"Songti SC",serif;font-size:34rpx;display:block;margin-top:8rpx;line-height:1.5}.blank{padding:180rpx 34rpx}.photo .painting{background:#fffaf0}

.day-previews{display:flex;gap:20rpx;margin:28rpx 0}.day-preview{width:calc(50% - 10rpx)}.day-preview image{width:100%;height:260rpx;background:#fffcf5}.action-item{border-top:1rpx solid #dcd7cb;padding:18rpx 0}.action-option{display:block;margin-top:20rpx}
