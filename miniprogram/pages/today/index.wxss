.artwork{position:relative;margin:30rpx 0 16rpx;aspect-ratio:2/3;height:calc((100vw - 72rpx)*1.5);max-height:1000rpx;background:#fffaf0;border:1rpx solid #ccc5b4;border-radius:6rpx;box-shadow:0 12rpx 36rpx rgba(65,91,72,.08);overflow:hidden}.painting{width:100%;height:100%;position:absolute}.art-title{position:absolute;top:30rpx;left:28rpx;writing-mode:vertical-rl;letter-spacing:9rpx;font-size:25rpx;font-family:"Songti SC",serif}.seal{position:absolute;right:26rpx;top:30rpx;width:50rpx;height:56rpx;border:2rpx solid #a44b3f;color:#a44b3f;text-align:center;line-height:50rpx;font-family:"Songti SC",serif;font-size:34rpx}.art-action{position:absolute;bottom:0;left:0;right:0;padding:26rpx 28rpx 32rpx;background:rgba(255,250,240,.95);border-top:1rpx solid #d2cdbf}.action-label{display:block;font-size:22rpx;letter-spacing:3rpx;color:#716e64}.action-text{font-family:"Songti SC",serif;font-size:34rpx;display:block;margin-top:8rpx;line-height:1.5}.blank{padding:180rpx 34rpx}.photo .painting{background:#fffaf0}

.day-previews{display:flex;gap:20rpx;margin:28rpx 0}.day-preview{width:calc(50% - 10rpx)}.day-preview image{width:100%;height:260rpx;background:#fffcf5}.action-item{border-top:1rpx solid #dcd7cb;padding:18rpx 0}.action-option{display:block;margin-top:20rpx}

.reading-map{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin:22rpx 0 30rpx}.reading-map>view{min-height:142rpx;padding:18rpx 16rpx;border:1rpx solid #dcd7cb;border-radius:8rpx;background:#fffcf5}.reading-map>view:nth-child(2){background:#f4eee2}.map-no{display:block;font-family:Georgia,serif;font-size:18rpx;letter-spacing:2rpx;color:#b5975c}.map-name{display:block;font-family:"Songti SC",serif;font-size:28rpx;color:#334a3a;margin-top:12rpx}.map-copy{display:block;font-size:21rpx;color:#8b877b;margin-top:4rpx}

.painting-message{margin:24rpx 0 36rpx}.companion-lead{display:block;margin:24rpx 0;line-height:1.7}
.break{display:block}.book{background:#e7e9dd;border:1rpx solid #b9c0ac;border-left:10rpx solid #415b48;padding:38rpx 30rpx;margin:36rpx 0 48rpx}.book-no{font-size:20rpx;letter-spacing:4rpx;color:#716e64}.book-answer{font-family:"Songti SC",serif;font-size:44rpx;white-space:pre-line;display:block;line-height:1.7;margin:38rpx 0}.book-detail{display:block;font-size:26rpx;color:#5e6657;margin:24rpx 0 34rpx}.answer-row{border-bottom:1rpx solid #dcd7cb}.answer-toggle{display:flex;align-items:center;text-align:left;background:transparent;font-size:27rpx;line-height:1.6;padding:26rpx 0;gap:18rpx}.answer-id{font-family:Georgia,serif;color:#8b877b;font-size:22rpx;min-width:84rpx}.answer-arrow{margin-left:auto;color:#415b48}.answer-detail{display:block;padding:0 0 26rpx 102rpx;font-size:25rpx;color:#716e64}

.companion-heading{margin-top:48rpx}.action-content{margin-top:0}.answer-content{margin-bottom:36rpx}
