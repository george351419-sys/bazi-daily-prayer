<view class="page"><text class="note">真机测试版 {{releaseVersion}}</text>
 <button wx:if="{{!status.plan}}" class="secondary" bindtap="wish">先去许愿池生成祈福图</button>
 <view wx:if="{{user&&status.plan}}" class="paper plan-panel">
  <text class="section-title">画屏呈现设置</text>
  <radio-group class="pill-row" bindchange="content">
   <label class="pill {{contentMode==='prayer'?'selected':''}}"><radio value="prayer" checked="{{contentMode==='prayer'}}" hidden/>祈福图</label>
   <label class="pill {{contentMode==='photo'?'selected':''}}"><radio value="photo" checked="{{contentMode==='photo'}}" hidden/>自己的照片</label>
  </radio-group>
  <block wx:if="{{contentMode==='photo'}}">
   <text class="note">照片模式会把上传的照片循环播放。先上传照片，再为今日与明日各选一张；两天选同一张则整轮只播这一张。</text>
   <text class="label">照片名称</text>
   <input class="field" value="{{photoTitle}}" data-field="photoTitle" bindinput="input" placeholder="例如：一家人的周末" maxlength="60"/>
   <button class="secondary spaced" bindtap="choosePhoto" disabled="{{busy}}">选择照片</button>
   <image wx:if="{{draft}}" class="photo-preview" src="{{draft}}" mode="aspectFit"/>
   <canvas type="2d" id="photo-canvas" class="photo-canvas"></canvas>
   <button class="secondary spaced" bindtap="upload" disabled="{{busy||!draft}}">上传到账户</button>
  </block>
  <text wx:if="{{contentMode!=='photo'}}" class="note">画屏可以分别设定「今日画面」与「明日画面」。两幅必须不同，否则画屏轮播时看不出变化。</text>
  <text class="label">今日{{contentMode==='photo'?'照片':'画面'}}</text>
  <picker mode="selector" range="{{titles}}" value="{{choices[0]}}" data-day="0" bindchange="choice" disabled="{{!artworks.length}}">
   <view class="picker-field">{{artworks[choices[0]]?artworks[choices[0]].title+' · '+artworks[choices[0]].date:(contentMode==='photo'?'暂无可选照片':'暂无可选画作')}}</view>
  </picker>
  <text class="label">明日{{contentMode==='photo'?'照片':'画面'}}</text>
  <picker mode="selector" range="{{titles}}" value="{{choices[1]}}" data-day="1" bindchange="choice" disabled="{{!artworks.length}}">
   <view class="picker-field">{{artworks[choices[1]]?artworks[choices[1]].title+' · '+artworks[choices[1]].date:(contentMode==='photo'?'暂无可选照片':'暂无可选画作')}}</view>
  </picker>
  <text wx:if="{{!artworks.length}}" class="note">{{contentMode==='photo'?'账户里还没有已上传的照片。请先在上方上传。':'账户里还没有已完成的祈福画。可先点下方「准备今日与明日画作」。'}}</text>
  <view class="check-row"><text class="note">在画面下方显示微行动建议</text><switch checked="{{showActions}}" bindchange="actions" color="#415b48"/></view>
  <block wx:if="{{contentMode!=='photo'}}">
   <text class="label">播放方式</text>
   <radio-group class="pill-row" bindchange="mode">
    <label class="pill {{mode==='daily'?'selected':''}}"><radio value="daily" checked="{{mode==='daily'}}" hidden/>日常 · 01:00 换画</label>
    <label class="pill {{mode==='test'?'selected':''}}"><radio value="test" checked="{{mode==='test'}}" hidden/>测试 · 每 2 分钟换动作</label>
   </radio-group>
   <button class="secondary spaced" bindtap="prepare" disabled="{{busy}}" loading="{{busy}}">准备今日与明日画作</button>
  </block>
  <button class="text-button" bindtap="more" wx:if="{{cursor}}" disabled="{{busy}}">载入更多画作</button>
  <button class="primary spaced" bindtap="save" disabled="{{busy}}" loading="{{busy}}">保存并同步到画屏</button>
  <text class="note">设备下次联网时领取新内容；保存成功不代表设备已完成显示。</text>
 </view>
 <view wx:if="{{user&&syncConfigured}}" class="paper unbind-panel">
  <text class="section-title">解除画屏绑定</text>
  <text class="note">解除后这台画屏不再归属你的账户，画屏保留原有画面，重新使用需再次认主关联。</text>
  <button class="secondary spaced" bindtap="unbind" disabled="{{busy}}" loading="{{busy}}">停用并解除绑定</button>
 </view>
 <view wx:if="{{user&&syncState}}" class="paper sync-panel">
  <text class="section-title">画面同步进展</text><text wx:if="{{syncState.phase==='rendered'}}" class="complete-badge">✓ 画屏已回报显示当前内容</text><text wx:if="{{syncState.phase==='user-confirmed'}}" class="complete-badge">✓ 你已确认画屏显示新画</text><text wx:if="{{syncState.phase==='stored'}}" class="complete-badge">✓ 当前内容包已保存 · 画面待确认</text><text class="label">{{syncState.title}}</text><text wx:if="{{syncState.detail}}" class="note">{{syncState.detail}}</text>
  <text wx:if="{{syncState.phase==='stored'||syncState.phase==='rendered'||syncState.phase==='user-confirmed'}}" class="complete-note">{{syncState.phase==='rendered'?'设备回报时间 '+syncLastSeen:syncState.phase==='user-confirmed'?'这是你的手动确认；设备尚未回报当前画面已刷新。':'画屏尚未回报当前画面已刷新。'}}{{syncState.phase==='stored'?' 内容包保存回执不代表屏上已经显示最新画。':''}}</text>
  <progress wx:if="{{syncState.percent!==null&&syncState.percent!==undefined}}" percent="{{syncState.percent}}" show-info stroke-width="4"/>
  <view class="sync-steps"><text class="{{syncState.step>=1?'complete':''}}">① 内容就绪</text><text class="{{syncState.step>=2?'complete':''}}">② 下载中</text><text class="{{syncState.step>=3?'complete':''}}">{{syncState.phase==='stored'||syncState.phase==='rendered'||syncState.phase==='user-confirmed'?'③ 内容包已保存':'③ 已保存'}}</text><text class="{{syncState.step>=4?'complete':''}}">{{syncState.phase==='rendered'?'④ 画屏已回报刷新':syncState.phase==='user-confirmed'?'④ 你已确认画面':'④ 等待画面回执'}}</text></view>
  <button class="secondary spaced" bindtap="syncNow" wx:if="{{syncState.action==='check'}}" disabled="{{!paired||busy}}">重新检查同步</button>
  <button class="text-button spaced" bindtap="toggleDelivered" wx:if="{{paired}}" disabled="{{busy}}">{{delivered?'已标记完成 · 点击撤销':'画屏已显示新画 · 标记完成'}}</button>
 </view>
<text class="kicker">CONNECT YOUR COMPANION / 02</text><text class="title">链接神物</text><text class="subtitle">连接画屏蓝牙与 Wi-Fi，在这里查看画面更新状态。</text><view class="error">{{error}}</view><view class="diagnostics"><button class="text-button" bindtap="diagnostics">复制连接诊断</button><button class="text-button" bindtap="statusDiagnostics">复制状态诊断</button><button class="text-button" bindtap="sendDiagnostic" disabled="{{sendingDiagnostic}}" loading="{{sendingDiagnostic}}">发送诊断到后台</button><button class="text-button" bindtap="heartbeatAddress" disabled="{{busy}}">读取设备心跳地址</button></view><view wx:if="{{diagnosticText}}" class="diagnostic-output"><text class="note">诊断内容（可长按选择并复制）</text><text selectable="true" user-select="true" class="diagnostic-text">{{diagnosticText}}</text></view><view wx:if="{{diagnosticReportId}}" class="diagnostic-output"><text class="note">报告编号（2小时内有效）：</text><text selectable="true" user-select="true" class="diagnostic-text">{{diagnosticReportId}}</text><text class="note">把编号发到当前对话，我就能读取报告。</text></view><text wx:if="{{heartbeatText}}" class="note">{{heartbeatText}}</text><text wx:if="{{heartbeatUrl}}" class="note">设备心跳地址：{{heartbeatUrl}}</text><view wx:if="{{message}}" class="notice">{{message}}</view><block><view class="paper connection-summary"><text class="section-title">当前连接</text><text class="note">蓝牙：{{paired?'已连接':'未连接'}} · Wi-Fi：{{wifiConnected?'已联网':'未确认联网'}}</text><text wx:if="{{!paired}}" class="note">蓝牙未连接。请先在下方唤醒并连接画屏蓝牙，连上后会自动认主，无需手动输入编号。</text><text wx:if="{{paired&&!syncConfigured}}" class="note">蓝牙已连接，正在自动认主；若未自动完成，可点下方「认主并关联账户」。</text><text wx:if="{{connectedDeviceId}}" class="note">画屏 {{connectedDeviceId}}</text><button wx:if="{{paired&&wifiConnected}}" class="text-button" bindtap="toggleSetup">{{setupExpanded?'收起连接设置':'展开连接设置'}}</button><button wx:if="{{paired&&!syncConfigured}}" class="primary spaced" bindtap="bind" disabled="{{busy||binding}}" loading="{{binding}}">认主并关联账户</button></view><view wx:if="{{!paired||!wifiConnected||setupExpanded}}" class="paper"><text class="kicker">01 / 连接画屏</text><text class="section-title">先让它连上网络</text><text class="note">唤醒画屏，开启手机蓝牙。请选名称以 FRAMEFILMARK 开头的设备。</text><button class="secondary spaced" bindtap="scan" disabled="{{busy}}">搜索附近画屏</button><button class="device" wx:for="{{bleDevices}}" wx:key="id" data-id="{{item.id}}" bindtap="connect" disabled="{{busy}}"><text>{{item.name}}</text><text class="muted">连接</text></button><text class="note">{{bleText}}</text><view><text class="label">2.4 GHz Wi-Fi 名称</text><input class="field" value="{{ssid}}" data-field="ssid" bindinput="input" placeholder="填写已有 Wi-Fi 名称" maxlength="32"/><text class="label">Wi-Fi 密码</text><view wx:if="{{savedSSID&&ssid===savedSSID&&!editingPassword}}"><input class="field" value="••••••••" disabled/><text class="note">已保存在画屏，将自动使用</text><button class="text-button" bindtap="changePassword">更换密码</button></view><input wx:else class="field" value="{{wifiPassword}}" data-field="wifiPassword" bindinput="input" password placeholder="{{savedSSID?'已保存在画屏，同名网络可留空':'填写该 Wi-Fi 当前使用的密码'}}" maxlength="63"/><button class="primary spaced" bindtap="wifi" disabled="{{busy||!paired}}" loading="{{busy}}">{{paired?'连接 Wi-Fi':'请先连接蓝牙，再连接 Wi-Fi'}}</button><button class="text-button" wx:if="{{paired}}" bindtap="disconnect" disabled="{{busy}}">断开蓝牙</button></view></view>
<button wx:if="{{!user}}" class="primary" bindtap="login">微信登录后连接画屏</button></block></view>

<privacy-consent/>
