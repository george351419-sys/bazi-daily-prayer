<view class="page"><text class="note">真机测试版 {{releaseVersion}}</text>
 <button wx:if="{{!status.plan}}" class="secondary" bindtap="wish">先去许愿池生成祈福图</button>
 <view wx:if="{{user&&syncState}}" class="paper sync-panel">
  <text class="section-title">画面同步进展</text><text wx:if="{{syncState.phase==='stored'||syncState.phase==='rendered'}}" class="complete-badge">✓ 本次同步已完成</text><text class="label">{{syncState.title}}</text><text wx:if="{{syncState.detail}}" class="note">{{syncState.detail}}</text>
  <text wx:if="{{syncState.phase==='stored'||syncState.phase==='rendered'}}" class="complete-note">本次内容已送达画屏 · {{syncState.completedAt&&syncLastSeen?'设备回报时间 '+syncLastSeen:'本机已确认送达'}}。此处无需再操作，也无需重新生成或重新连接。</text>
  <progress wx:if="{{syncState.percent!==null&&syncState.percent!==undefined}}" percent="{{syncState.percent}}" show-info stroke-width="4"/>
  <view class="sync-steps"><text class="{{syncState.step>=1?'complete':''}}">① 内容就绪</text><text class="{{syncState.step>=2?'complete':''}}">② 下载中</text><text class="{{syncState.step>=3?'complete':''}}">{{syncState.phase==='stored'||syncState.phase==='rendered'?'③ 传输完成':'③ 已保存'}}</text><text wx:if="{{syncState.phase!=='stored'&&syncState.phase!=='rendered'}}" class="{{syncState.step>=4?'complete':''}}">④ 已刷新</text></view>
  <button class="secondary spaced" bindtap="syncNow" wx:if="{{syncState.action==='check'}}" disabled="{{!paired||busy}}">重新检查同步</button>
  <button class="text-button spaced" bindtap="toggleDelivered" wx:if="{{paired}}" disabled="{{busy}}">{{delivered?'已标记完成 · 点击撤销':'画屏已显示新画 · 标记完成'}}</button>
 </view>
<text class="kicker">CONNECT YOUR COMPANION / 02</text><text class="title">链接神物</text><text class="subtitle">连接画屏蓝牙与 Wi-Fi，在这里查看画面更新状态。</text><view class="error">{{error}}</view><view class="diagnostics"><button class="text-button" bindtap="diagnostics">复制连接诊断</button><button class="text-button" bindtap="statusDiagnostics">复制状态诊断</button><button class="text-button" bindtap="heartbeatAddress" disabled="{{busy}}">读取设备心跳地址</button></view><text wx:if="{{heartbeatText}}" class="note">{{heartbeatText}}</text><text wx:if="{{heartbeatUrl}}" class="note">设备心跳地址：{{heartbeatUrl}}</text><view wx:if="{{message}}" class="notice">{{message}}</view><block><view class="paper connection-summary"><text class="section-title">当前连接</text><text class="note">蓝牙：{{paired?'已连接':'未连接'}} · Wi-Fi：{{wifiConnected?'已联网':'未确认联网'}}</text><text wx:if="{{!paired}}" class="note">蓝牙未连接。请先在下方唤醒并连接画屏蓝牙，连上后会自动认主，无需手动输入编号。</text><text wx:if="{{paired&&!syncConfigured}}" class="note">蓝牙已连接，正在自动认主；若未自动完成，可点下方「认主并关联账户」。</text><text wx:if="{{connectedDeviceId}}" class="note">画屏 {{connectedDeviceId}}</text><button wx:if="{{paired&&wifiConnected}}" class="text-button" bindtap="toggleSetup">{{setupExpanded?'收起连接设置':'展开连接设置'}}</button><button wx:if="{{paired&&!syncConfigured}}" class="primary spaced" bindtap="bind" disabled="{{busy||binding}}" loading="{{binding}}">认主并关联账户</button></view><view wx:if="{{!paired||!wifiConnected||setupExpanded}}" class="paper"><text class="kicker">01 / 连接画屏</text><text class="section-title">先让它连上网络</text><text class="note">唤醒画屏，开启手机蓝牙。请选名称以 FRAMEFILMARK 开头的设备。</text><button class="secondary spaced" bindtap="scan" disabled="{{busy}}">搜索附近画屏</button><button class="device" wx:for="{{bleDevices}}" wx:key="id" data-id="{{item.id}}" bindtap="connect" disabled="{{busy}}"><text>{{item.name}}</text><text class="muted">连接</text></button><text class="note">{{bleText}}</text><view><text class="label">2.4 GHz Wi-Fi 名称</text><input class="field" value="{{ssid}}" data-field="ssid" bindinput="input" placeholder="填写已有 Wi-Fi 名称" maxlength="32"/><text class="label">Wi-Fi 密码</text><view wx:if="{{savedSSID&&ssid===savedSSID&&!editingPassword}}"><input class="field" value="••••••••" disabled/><text class="note">已保存在画屏，将自动使用</text><button class="text-button" bindtap="changePassword">更换密码</button></view><input wx:else class="field" value="{{wifiPassword}}" data-field="wifiPassword" bindinput="input" password placeholder="{{savedSSID?'已保存在画屏，同名网络可留空':'填写该 Wi-Fi 当前使用的密码'}}" maxlength="63"/><button class="primary spaced" bindtap="wifi" disabled="{{busy||!paired}}" loading="{{busy}}">{{paired?'连接 Wi-Fi':'请先连接蓝牙，再连接 Wi-Fi'}}</button><button class="text-button" wx:if="{{paired}}" bindtap="disconnect" disabled="{{busy}}">断开蓝牙</button></view></view>
<button wx:if="{{!user}}" class="primary" bindtap="login">微信登录后连接画屏</button></block></view>

<privacy-consent/>
