<view class="page">
 <button wx:if="{{!status.plan}}" class="secondary" bindtap="wish">先去许愿池生成祈福图</button>
 <view wx:if="{{user&&syncState}}" class="paper sync-panel">
  <text class="section-title">{{syncState.title}}</text><text wx:if="{{syncState.detail}}" class="note">{{syncState.detail}}</text>
  <progress wx:if="{{syncState.percent!==null&&syncState.percent!==undefined}}" percent="{{syncState.percent}}" show-info stroke-width="4"/>
  <view class="sync-steps"><text class="{{syncState.step>=1?'complete':''}}">① 内容就绪</text><text class="{{syncState.step>=2?'complete':''}}">② 下载中</text><text class="{{syncState.step>=3?'complete':''}}">③ 已保存</text><text class="{{syncState.step>=4?'complete':''}}">④ 已刷新</text></view>
  <button class="secondary spaced" bindtap="syncNow" wx:if="{{syncState.action==='check'}}" disabled="{{!paired||busy}}">重新检查同步</button>
 </view>
<text class="kicker">CONNECT YOUR COMPANION / 02</text><text class="title">链接神物</text><text class="subtitle">内容准备完成后，再连接画屏蓝牙与 Wi-Fi。</text><view class="error">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view><block wx:if="{{syncState.step>=1}}"><view class="paper"><text class="kicker">01 / 连接画屏</text><text class="section-title">先让它连上网络</text><text class="note">唤醒画屏，开启手机蓝牙。请选名称以 FRAMEFILMARK 开头的设备。</text><button class="secondary spaced" bindtap="scan" disabled="{{busy}}">搜索附近画屏</button><button class="device" wx:for="{{bleDevices}}" wx:key="id" data-id="{{item.id}}" bindtap="connect" disabled="{{busy}}"><text>{{item.name}}</text><text class="muted">连接</text></button><text class="note">{{bleText}}</text><view wx:if="{{paired}}"><text class="label">2.4 GHz Wi-Fi 名称</text><input class="field" value="{{ssid}}" data-field="ssid" bindinput="input" maxlength="32"/><text class="label">Wi-Fi 密码</text><input class="field" value="{{wifiPassword}}" data-field="wifiPassword" bindinput="input" password maxlength="63"/><text class="note">密码仅经蓝牙发给所选画屏，不上传后台。</text><button class="primary spaced" bindtap="wifi" disabled="{{busy}}" loading="{{busy}}">发送 Wi-Fi 设置</button><button class="text-button" bindtap="disconnect" disabled="{{busy}}">断开蓝牙</button></view></view>
<view wx:if="{{user}}"><view class="paper"><text class="section-title">账户与画屏</text><text wx:if="{{status.device}}" class="note">{{status.device.id}} · {{status.device.active?'当前使用本账户':'当前使用另一关联账户'}}{{status.device.memberCount>1?' · 已关联 '+status.device.memberCount+' 个账户':''}}</text><text wx:else class="note">尚未绑定设备</text><view wx:if="{{status.deviceLinked&&!status.device.active}}" class="notice">这台画屏已关联多个账户。连接附近画屏后，可将当前账户设为屏幕内容的下发账户。</view><button wx:if="{{paired && connectedDeviceId}}" class="secondary spaced" bindtap="bind" disabled="{{busy}}">{{status.device.id?'将本账户设为当前画屏账户':'绑定当前蓝牙画屏'}}</button><button wx:if="{{status.device.id}}" class="text-button" bindtap="unbind" disabled="{{busy}}">解除本账户与画屏的关联</button><text class="note">蓝牙连接不等于账户绑定。不同微信账户可关联同一台画屏，但同一时间只使用一个账户的内容。</text></view></view><button wx:else class="primary" bindtap="login">微信登录后绑定我的画屏</button></block></view>
