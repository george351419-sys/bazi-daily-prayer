<view class="page"><text class="note">真机测试版 {{releaseVersion}}</text>
 <button wx:if="{{!status.plan}}" class="secondary" bindtap="wish">先去许愿池生成祈福图</button>
<text class="kicker">CONNECT YOUR COMPANION / 02</text><text class="title">链接神物</text><text class="subtitle">连接画屏蓝牙与 Wi-Fi，在这里查看画面更新状态。</text><view class="error">{{error}}</view><view wx:if="{{message}}" class="notice">{{message}}</view><block><view class="paper connection-summary"><text class="section-title">当前连接</text><text class="note">蓝牙：{{paired?'已连接':'未连接'}} · Wi-Fi：{{wifiConnected?'已联网':'未确认联网'}}</text><text wx:if="{{!paired}}" class="note">蓝牙未连接。请先在下方唤醒并连接画屏蓝牙，连上后会自动认主，无需手动输入编号。</text><text wx:if="{{paired&&!syncConfigured}}" class="note">蓝牙已连接，自动绑定进展可在下方「画屏绑定」查看。</text><text wx:if="{{connectedDeviceId}}" class="note">画屏 {{connectedDeviceId}}</text><button wx:if="{{paired&&wifiConnected}}" class="text-button" bindtap="toggleSetup">{{setupExpanded?'收起连接设置':'展开连接设置'}}</button><button wx:if="{{paired&&!syncConfigured}}" class="primary spaced" bindtap="bind" disabled="{{busy||binding}}" loading="{{binding}}">认主并关联账户</button></view><view wx:if="{{!paired||!wifiConnected||setupExpanded}}" class="paper"><text class="kicker">01 / 连接画屏</text><text class="section-title">先让它连上网络</text><text class="note">唤醒画屏，开启手机蓝牙。请选名称以 FRAMEFILMARK 开头的设备。</text><button class="secondary spaced" bindtap="scan" disabled="{{busy}}">搜索附近画屏</button><button class="device" wx:for="{{bleDevices}}" wx:key="id" data-id="{{item.id}}" bindtap="connect" disabled="{{busy}}"><text>{{item.name}}</text><text class="muted">连接</text></button><text class="note">{{bleText}}</text><view><text class="label">2.4 GHz Wi-Fi 名称</text><input class="field" value="{{ssid}}" data-field="ssid" bindinput="input" placeholder="填写已有 Wi-Fi 名称" maxlength="32"/><text class="label">Wi-Fi 密码</text><view wx:if="{{savedSSID&&ssid===savedSSID&&!editingPassword}}"><input class="field" value="••••••••" disabled/><text class="note">已保存在画屏，将自动使用</text><button class="text-button" bindtap="changePassword">更换密码</button></view><input wx:else class="field" value="{{wifiPassword}}" data-field="wifiPassword" bindinput="input" password placeholder="{{savedSSID?'已保存在画屏，同名网络可留空':'填写该 Wi-Fi 当前使用的密码'}}" maxlength="63"/><button class="primary spaced" bindtap="wifi" disabled="{{busy||!paired}}" loading="{{busy}}">{{paired?'连接 Wi-Fi':'请先连接蓝牙，再连接 Wi-Fi'}}</button><button class="text-button" wx:if="{{paired}}" bindtap="disconnect" disabled="{{busy}}">断开蓝牙</button></view></view>
<button wx:if="{{!user}}" class="primary" bindtap="login">微信登录后连接画屏</button></block>
 <view class="paper diagnostics-panel">
  <button class="text-button wide" bindtap="toggleDiagnostics">链接诊断 {{diagnosticsExpanded?'收起':'展开'}}</button>
  <view wx:if="{{diagnosticsExpanded}}"><view class="diagnostics"><button class="text-button" bindtap="diagnostics">复制连接诊断</button><button class="text-button" bindtap="statusDiagnostics">复制状态诊断</button><button class="text-button" bindtap="sendDiagnostic" disabled="{{sendingDiagnostic}}" loading="{{sendingDiagnostic}}">发送诊断到后台</button><button class="text-button" bindtap="heartbeatAddress" disabled="{{busy}}">读取设备心跳地址</button></view><view wx:if="{{diagnosticText}}" class="diagnostic-output"><text class="note">诊断内容（可长按选择并复制）</text><text selectable="true" user-select="true" class="diagnostic-text">{{diagnosticText}}</text></view><view wx:if="{{diagnosticReportId}}" class="diagnostic-output"><text class="note">报告编号（2小时内有效）：</text><text selectable="true" user-select="true" class="diagnostic-text">{{diagnosticReportId}}</text><text class="note">把编号发到当前对话，我就能读取报告。</text></view><text wx:if="{{heartbeatText}}" class="note">{{heartbeatText}}</text><text wx:if="{{heartbeatUrl}}" class="note">设备心跳地址：{{heartbeatUrl}}</text></view>
 </view>
 <view wx:if="{{user&&syncState}}" class="paper sync-panel">
  <text class="section-title">画面同步进展</text><text class="note">{{syncContentTitle}}</text><text wx:if="{{syncContentDetail}}" class="note">{{syncContentDetail}}</text><text wx:if="{{syncState.phase==='rendered'}}" class="complete-badge">✓ 画屏已回报显示当前内容</text><text wx:if="{{syncState.phase==='user-confirmed'}}" class="complete-badge">✓ 你已确认画屏显示新画</text><text wx:if="{{syncState.phase==='stored'}}" class="complete-badge">✓ 内容已保存 · 现在可以进入画面</text><text class="label">{{syncState.title}}</text><text wx:if="{{syncState.detail}}" class="note">{{syncState.detail}}</text>
  <text wx:if="{{syncState.phase==='rendered'||syncState.phase==='user-confirmed'}}" class="complete-note">{{syncState.phase==='rendered'?'设备回报时间 '+syncLastSeen:'这是你的手动确认；设备尚未回报当前画面已刷新。'}}</text>
  <progress wx:if="{{syncState.percent!==null&&syncState.percent!==undefined}}" percent="{{syncState.percent}}" show-info stroke-width="4"/>
  <view class="sync-steps"><text class="{{syncState.step>=1?'complete':''}}">① 内容就绪</text><text class="{{syncState.step>=2?'complete':''}}">② 下载中</text><text class="{{syncState.step>=3?'complete':''}}">{{syncState.phase==='stored'||syncState.phase==='rendered'||syncState.phase==='user-confirmed'?'③ 内容包已保存':'③ 已保存'}}</text><text class="{{syncState.step>=4?'complete':''}}">{{syncState.phase==='rendered'?'④ 画屏已回报刷新':syncState.phase==='user-confirmed'?'④ 你已确认画面':syncState.phase==='stored'?'④ 现在可以进入画面':'④ 等待画面刷新'}}</text></view>
  <button class="secondary spaced" bindtap="syncNow" wx:if="{{syncState.action==='check'}}" disabled="{{!paired||busy}}">重新检查同步</button>
  <button wx:if="{{paired&&status.build.status==='published'&&!status.deviceReport.stored&&!status.deviceReport.renderedCurrent}}" class="secondary spaced" bindtap="recoverSync" disabled="{{busy||binding||checkingSync}}" loading="{{checkingSync}}">恢复画屏联网并重试</button>
  <text wx:if="{{paired&&status.build.status==='published'&&!status.deviceReport.stored&&!status.deviceReport.renderedCurrent}}" class="note">若长时间没有进展，可用已保存的 Wi-Fi 重连一次；不会清除照片或重新配网。</text>
  <button class="text-button spaced" bindtap="toggleDelivered" wx:if="{{paired}}" disabled="{{busy}}">{{delivered?'已手动标记看到新画 · 点击撤销':'我已在画屏看到新画（可选标记）'}}</button>
 </view>
 <view wx:if="{{user}}" class="paper prayer-preview-panel">
  <button class="text-button wide" bindtap="togglePreview">画作预览 {{previewExpanded?'收起':'展开'}}</button>
  <view wx:if="{{previewExpanded}}">
   <view class="choice-row"><button class="choice {{previewDay===0?'selected':''}}" data-day="0" bindtap="selectPreviewDay">今日</button><button class="choice {{previewDay===1?'selected':''}}" data-day="1" bindtap="selectPreviewDay">明天</button></view>
   <text class="note">{{previewDate}} · 祈福画作预览</text>
   <text wx:if="{{previewLoading}}" class="note">正在载入画作…</text>
   <text wx:elif="{{previewError}}" class="error">{{previewError}}</text>
   <image wx:elif="{{previewImage}}" class="prayer-preview-image" src="{{previewImage}}" mode="aspectFit"/>
   <text wx:else class="note">{{previewDay===0?'今日祈福画尚未就绪。':'明日祈福画尚未就绪，准备完成后可在这里查看。'}}</text>
   <button class="text-button spaced" bindtap="refreshPreview" disabled="{{previewLoading}}">刷新预览</button>
   <text class="note">这里预览祈福画；画屏实际播放内容及是否同步完成，以上方同步进展为准。</text>
  </view>
 </view>
 <view wx:if="{{user}}" class="paper binding-panel">
  <button class="text-button wide" bindtap="toggleBindingPanel">画屏绑定 · {{syncConfigured?'已绑定':'未绑定'}} {{syncConfigured&&!binding?(bindingExpanded?'收起':'展开'):''}}</button>
  <view wx:if="{{!syncConfigured||binding||bindingExpanded}}">
   <block wx:if="{{binding||!syncConfigured}}">
    <text wx:if="{{binding}}" class="note">正在自动绑定画屏，请保持画屏唤醒，等待账户关联完成。</text>
    <text wx:elif="{{bindingError}}" class="error">{{bindingError}}</text>
    <text wx:elif="{{!paired}}" class="note">尚未绑定画屏。请先连接画屏蓝牙和 Wi-Fi，连接后会自动绑定到当前账户。</text>
    <text wx:elif="{{!wifiConnected}}" class="note">蓝牙已连接，请继续连接画屏 Wi-Fi，联网后会自动绑定。</text>
    <text wx:else class="note">正在检查并自动绑定画屏，请保持画屏唤醒。</text>
    <button wx:if="{{paired&&wifiConnected&&!binding}}" class="secondary spaced" bindtap="bind" disabled="{{busy}}">重试绑定画屏</button>
   </block>
   <block wx:elif="{{syncConfigured}}">
    <text class="note">画屏已绑定到当前账户{{status.device.id?' · '+status.device.id:''}}。</text>
    <text class="note">解除后这台画屏不再归属你的账户，画屏保留原有画面，重新使用需再次绑定。</text>
    <button class="secondary spaced" bindtap="unbind" disabled="{{busy||binding}}" loading="{{busy}}">解除画屏绑定</button>
   </block>
  </view>
 </view>
</view>

<privacy-consent/>
