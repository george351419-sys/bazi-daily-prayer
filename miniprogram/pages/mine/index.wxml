<view class="page">
 <text class="kicker">A WISH OF YOUR OWN / 01</text>
 <text class="title">许愿池</text>
 <text class="subtitle">选一份祈愿，挑一种画风，让心愿入画。</text>
 <text class="note">无需登录即可选择和浏览，生成时再自愿登录保存画作。</text>
 <view class="error" role="alert">{{error}}</view>
 <view class="notice" wx:if="{{message}}">{{message}}</view>
 <view class="paper">
  <text class="section-title">今天的祈愿</text>
  <view wx:for="{{groups}}" wx:key="name" class="wish-group"><text class="label">{{item.name}}</text><text wx:for="{{item.items}}" wx:for-item="wish" wx:key="id" class="pill {{wish.selected?'selected':''}}" data-id="{{wish.id}}" bindtap="wish">{{wish.label}}</text></view>
 </view>
 <view class="paper">
  <button class="text-button wide" bindtap="toggleStyle">选择画面风格 · {{profile.artStyle==='folk'?'民俗风':profile.artStyle==='spirit'?'灵兽风':'可爱风'}} {{styleOpen?'收起':'展开'}}</button>
  <view wx:if="{{styleOpen}}">
  <view wx:for="{{artStyles}}" wx:key="id" class="art-style-row"><button class="choice {{styleSelected&&profile.artStyle===item.id?'selected':''}}" data-field="artStyle" data-value="{{item.id}}" bindtap="choose" disabled="{{busy}}"><text>{{item.label}}</text><text class="note">{{item.description}}</text></button><button class="text-button" data-id="{{item.id}}" bindtap="previewArtStyle">查看示例</button></view>
  </view>
 </view>
 <view class="paper">
  <button class="text-button" bindtap="toggleBirthday">个性化设置 · 生日纪念（选填） {{birthdayOpen?'收起':'展开'}}</button>
  <text class="note">不填写也可以生成；已填资料仅用于个性化画面。</text><text wx:if="{{profile.birthDate}}" class="note">生日资料：{{profile.birthDate}} {{profile.birthTime}} · {{profile.calendar==='lunar'?'农历':'公历'}}</text>
  <view wx:if="{{birthdayOpen}}">
   <text class="label">性别</text>
   <view class="choice-row">
    <button class="choice {{profile.gender==='female'?'selected':''}}" data-field="gender" data-value="female" bindtap="choose">女</button>
    <button class="choice {{profile.gender==='male'?'selected':''}}" data-field="gender" data-value="male" bindtap="choose">男</button>
   </view>
   <text class="label">历法</text>
   <view class="choice-row">
    <button class="choice {{profile.calendar==='solar'?'selected':''}}" data-field="calendar" data-value="solar" bindtap="choose">公历</button>
    <button class="choice {{profile.calendar==='lunar'?'selected':''}}" data-field="calendar" data-value="lunar" bindtap="choose">农历</button>
   </view>
   <text class="label">生日纪念日期{{profile.calendar==='lunar'?' · 请选择农历年月日数字':''}}</text>
   <picker mode="date" start="1900-01-01" end="{{today}}" value="{{profile.birthDate}}" data-field="birthDate" bindchange="field">
    <view class="field">{{profile.birthDate||'选择生日'}}</view>
   </picker>
   <view class="check-row" wx:if="{{profile.calendar==='lunar'}}">
    <text>农历闰月</text>
    <switch color="#415B48" checked="{{profile.leap}}" bindchange="leap"/>
   </view>
   <text class="label">纪念时刻 · 北京时间</text>
   <picker mode="time" value="{{profile.birthTime}}" data-field="birthTime" bindchange="field">
    <view class="field">{{profile.birthTime||'选择纪念时刻'}}</view>
   </picker>
   <text class="label">城市 · 选填</text>
   <input class="field" value="{{profile.city}}" data-field="city" bindinput="field" maxlength="60" placeholder="例如：上海"/>

   <button class="text-button" bindtap="clearBirthday">清除生日纪念资料</button>
  </view>
 </view>
 <button class="primary spaced wide" bindtap="generate" disabled="{{busy}}">生成我的祈福画</button>
 <view id="generation-login" class="paper" wx:if="{{loginOpen&&!user}}">
  <text class="section-title">登录后继续生成</text>
  <text class="note">登录用于保存和找回画作，不需要手机号、头像或昵称。取消后保留当前选择。</text>
  <button class="primary spaced wide" bindtap="wechatAuth" loading="{{busy}}" disabled="{{busy||!wechatEnabled}}">微信登录并继续</button>
  <text class="note" wx:if="{{!wechatEnabled}}">登录服务暂不可用，请稍后重试。</text>
  <button class="text-button" bindtap="cancelLogin" disabled="{{busy}}">暂不登录，继续浏览</button>
  <button class="text-button" bindtap="legacy">{{authMode==='legacy'?'返回微信登录':'使用已有网页账户'}}</button>
  <view wx:if="{{authMode==='legacy'}}"><input class="field" value="{{username}}" data-field="username" bindinput="input" maxlength="24" placeholder="已有网页账号"/><input class="field" value="{{password}}" password data-field="password" bindinput="input" maxlength="128" placeholder="账户密码"/><button class="secondary spaced wide" bindtap="auth" loading="{{busy}}" disabled="{{busy}}">登录并继续生成</button></view>
 </view>
 <view wx:if="{{user}}" class="paper"><text class="note">已登录，画作将保存在你的账户中。</text><button class="text-button" bindtap="logout" disabled="{{busy}}">退出登录</button></view>
 <view class="privacy"><button class="text-button" bindtap="privacy">{{privacyOpen?'收起说明':'查看数据用途与权限'}}</button><view wx:if="{{privacyOpen}}"><text class="note">祈愿、画风及自愿填写的生日纪念资料用于个性化绘画。画作和照片保存在你的账户。仅在主动生成时选择登录；不收集手机号、头像或昵称。选择照片及连接画屏时按需请求权限。Wi-Fi 密码仅通过蓝牙发给你选择的设备。</text><button class="text-button" bindtap="openPrivacy">微信隐私保护指引</button></view></view>
</view>
<privacy-consent/>
