.mode-banner{display:flex;align-items:center;justify-content:space-between;gap:20rpx;background:#e9ecdf;border:1rpx solid #b9c1b0;border-left:8rpx solid #415b48;padding:24rpx 26rpx;margin:28rpx 0}.mode-banner .section-title{margin:6rpx 0 0}.photo-list{display:flex;flex-direction:column;gap:16rpx;margin-top:24rpx}.photo-row{display:grid;grid-template-columns:116rpx minmax(0,1fr);gap:16rpx;padding:16rpx;border:1rpx solid #ddd8ca;background:#fff}.photo-thumb{position:relative;width:116rpx;height:94rpx;background:#e9e4d8}.photo-thumb image{width:100%;height:100%}.photo-thumb>text{position:absolute;left:6rpx;top:6rpx;min-width:34rpx;padding:2rpx 8rpx;background:rgba(65,91,72,.92);color:#fffdf6;text-align:center;font-family:Georgia,serif;font-size:21rpx}.photo-copy{min-width:0;display:flex;flex-direction:column;justify-content:center}.photo-name{display:block;font-size:27rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.order-row{grid-column:1/-1;display:flex;justify-content:flex-end;gap:12rpx}.mini-button{min-width:68rpx;min-height:58rpx;padding:4rpx 14rpx;border:1rpx solid #cbc6b8;background:#fff;color:#415b48;font-size:24rpx;line-height:1.4}.mini-button.remove{min-width:104rpx}.action-row{border-top:1rpx solid #e0dbcf;border-bottom:1rpx solid #e0dbcf;margin-top:24rpx}.action-row .note{margin-top:4rpx}.available-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin-top:20rpx}.available-item{display:flex;flex-direction:column;align-items:stretch;gap:10rpx;padding:12rpx;border:1rpx solid #ddd8ca;background:#fff;text-align:left;color:#272e28}.available-item image{width:100%;aspect-ratio:4/3;background:#eee9de}.available-item>text{font-size:24rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.available-item .add-label{color:#415b48;font-size:22rpx}.action-buttons{margin-top:30rpx}.photo-canvas{position:fixed;left:-2000px;top:0;width:1440px;height:1440px;pointer-events:none}
