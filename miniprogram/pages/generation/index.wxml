<view class="page">
 <text class="kicker">YOUR DAILY PORTRAIT</text>
 <text class="title">{{phase==='complete'?'今日造像':phase==='failed'?'生成暂未完成':'今日造像正在展开'}}</text>
 <image wx:if="{{image}}" class="generated-image" src="{{image}}" mode="widthFix"/>
 <text wx:if="{{phase==='complete'&&requiresSwitch}}" class="note">画屏当前使用自定义照片。先切换为这幅祈福图，再连接画屏同步；未切换时会继续播放照片。</text>
 <button wx:if="{{phase==='complete'&&requiresSwitch}}" class="primary spaced wide" bindtap="switchToPrayer" loading="{{preparing}}" disabled="{{preparing}}">切换为这幅祈福画</button>
 <button wx:if="{{phase==='complete'&&requiresSwitch===false}}" class="primary spaced wide" bindtap="connectScreen" disabled="{{preparing}}">连接画屏并同步祈福图</button>
 <text wx:if="{{phase==='complete'&&requiresSwitch===null}}" class="note">正在确认画屏当前的播放模式…</text>
 <button wx:if="{{image}}" class="secondary spaced wide" bindtap="saveWallpaper" loading="{{savingImage}}" disabled="{{savingImage}}">保存图片做壁纸</button>
 <button wx:if="{{image&&artworkId}}" class="secondary spaced wide" bindtap="explanation" loading="{{openingExplanation}}" disabled="{{openingExplanation}}">查看这幅画的网页说明</button>
 <button wx:if="{{phase==='complete'}}" class="text-button spaced wide" bindtap="regenerate" disabled="{{preparing}}">重新生成一幅</button>
 <text wx:if="{{saveError}}" class="error">{{saveError}}</text>
 <view wx:if="{{phase!=='complete'}}" class="paper" role="status"><text class="section-title">{{text}}</text><view wx:if="{{phase!=='complete'}}" class="generation-steps"><text class="{{phase==='analyzing'?'current':''}}">01 整理祈愿</text><text class="{{phase==='drawing'?'current':''}}">02 心愿入画</text><text>03 今日造像</text></view><text wx:if="{{phase!=='complete'&&phase!=='failed'}}" class="note">通常需要一至两分钟，画面完成后会立即显示。</text><text wx:if="{{error}}" class="error">{{error}}</text><button wx:if="{{phase==='failed'}}" class="primary spaced" bindtap="retry">继续生成今日造像</button><button wx:if="{{imageError}}" class="secondary spaced" bindtap="reloadImage">重新载入画面</button></view>
 <view wx:if="{{phase==='complete'&&requiresSwitch===false}}" class="paper"><text class="section-title">为明天提前准备</text><text class="note">{{preparing?'正在补齐明日画作，后台会继续准备两天微行动与画屏数据，无需等待设备连接。':preparation}}</text><text wx:if="{{preparationError}}" class="error">两日计划暂未提交完成：{{preparationError}}</text><button wx:if="{{preparationError&&!requiresSwitch}}" class="secondary spaced" bindtap="retryPreparation" disabled="{{preparing}}">重试准备两日内容</button></view>
 <view wx:if="{{phase==='complete'&&imageError}}"><text class="error">{{error}}</text><button class="secondary spaced" bindtap="reloadImage">重新载入画面</button></view>
 <view wx:if="{{phase==='complete'&&preparationError}}"><text class="error">两日计划暂未提交完成：{{preparationError}}</text><button class="secondary spaced" bindtap="retryPreparation" disabled="{{preparing}}">重试准备两日内容</button></view>
</view>

<privacy-consent/>
