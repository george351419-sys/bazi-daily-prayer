<view class="page">
 <text class="kicker">YOUR DAILY PORTRAIT</text>
 <text class="title">{{phase==='complete'?'今日造像':phase==='failed'?'生成暂未完成':'今日造像正在展开'}}</text>
 <image wx:if="{{image}}" class="generated-image" src="{{image}}" mode="widthFix"/>
 <button wx:if="{{phase==='complete'}}" class="primary spaced wide" bindtap="connectScreen">去连接神物</button>
 <button wx:if="{{image}}" class="secondary spaced wide" bindtap="saveWallpaper" loading="{{savingImage}}" disabled="{{savingImage}}">保存图片做壁纸</button>
 <button wx:if="{{image&&artworkId}}" class="secondary spaced wide" bindtap="explanation" loading="{{openingExplanation}}" disabled="{{openingExplanation}}">查看这幅画的网页说明</button>
 <button wx:if="{{image&&artworkId}}" class="text-button spaced wide" bindtap="copyExplanation" disabled="{{openingExplanation}}">复制网页说明链接</button>
 <text wx:if="{{saveError}}" class="error">{{saveError}}</text>
 <view class="paper" role="status"><text class="section-title">{{text}}</text><view wx:if="{{phase!=='complete'}}" class="generation-steps"><text class="{{phase==='analyzing'?'current':''}}">01 整理祈愿</text><text class="{{phase==='drawing'?'current':''}}">02 心愿入画</text><text>03 今日造像</text></view><text wx:if="{{phase!=='complete'&&phase!=='failed'}}" class="note">通常需要一至两分钟，画面完成后会立即显示。</text><text wx:if="{{error}}" class="error">{{error}}</text><button wx:if="{{phase==='failed'}}" class="primary spaced" bindtap="retry">继续生成今日造像</button><button wx:if="{{imageError}}" class="secondary spaced" bindtap="reloadImage">重新载入画面</button></view>
 <view wx:if="{{phase==='complete'}}" class="paper"><text class="section-title">为明天提前准备</text><text class="note">{{preparing?'正在补齐明日画作，后台会继续准备两天微行动与画屏数据，无需等待设备连接。':preparation}}</text><text wx:if="{{preparationError}}" class="error">两日计划暂未提交完成：{{preparationError}}</text><button wx:if="{{preparationError}}" class="secondary spaced" bindtap="retryPreparation" disabled="{{preparing}}">重试准备两日内容</button></view>
</view>

<privacy-consent/>
