DEEPSEEK_API_KEY=
ARK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
ARK_IMAGE_MODEL=doubao-seedream-5-0-flash-260915
PORT=8787

# Production uses EdgeOne Blob; keep SESSION_SECRET stable for encrypted account data.
SESSION_SECRET=
ACCOUNT_STORAGE=file
ACCOUNT_DATA_DIR=.runtime/accounts

# Tencent Cloud SES: approved sender and template, server-side only.
TENCENT_SES_REGION=ap-hongkong
TENCENT_SES_SECRET_ID=
TENCENT_SES_SECRET_KEY=
TENCENT_SES_TEMPLATE_ID=
MAIL_FROM=生辰造像馆 <noreply@mail.playmath.cn>
