DEEPSEEK_API_KEY=
ARK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
ARK_IMAGE_MODEL=doubao-seedream-5-0-flash-260915
PORT=8787

# Production uses EdgeOne Blob; keep SESSION_SECRET stable for encrypted account data.
SESSION_SECRET=
ACCOUNT_STORAGE=file
ACCOUNT_DATA_DIR=.runtime/accounts

# Production site enables this so a long-running Worker can pull account snapshots over HMAC.
RITUAL_PUBLIC_ORIGIN=https://playmath.cn
RITUAL_WORKER_REMOTE=0
# PRAYER_TEST_PYTHON=/opt/homebrew/bin/python3
