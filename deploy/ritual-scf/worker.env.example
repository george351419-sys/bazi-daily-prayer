# These are SCF console environment variables, not a shell script.
# Copy the same secret already used by EdgeOne. Never generate a replacement.
RITUAL_PUBLIC_ORIGIN=https://playmath.cn
SESSION_SECRET=
# Start in read-only probe mode. Change worker function to worker after cutover.
RITUAL_SCF_MODE=probe
RITUAL_SCF_MAX_ACCOUNTS=2
# Keep empty to process all accounts. Optionally restrict initial acceptance.
RITUAL_WORKER_ACCOUNT=
RITUAL_PREPARATION_GRACE_MINUTES=30
RITUAL_PUBLICATION_GRACE_MINUTES=20
RITUAL_RECEIPT_GRACE_MINUTES=30
# One SCF invocation uses temporary local cache; cloud checkpoints are durable.
RITUAL_ALERT_PROVIDER=log
