{
  "name": "daily-prayer-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env.local server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build-static.mjs",
    "build:edgeone": "node scripts/build-edgeone.mjs",
    "test:devices:integration": "node scripts/check-device-loop.mjs",
    "demo:devices": "node scripts/start-device-demo.mjs",
    "worker:daily": "node --env-file-if-exists=.env.local scripts/run-daily-worker.mjs",
    "test:daily:integration": "node scripts/check-daily-loop.mjs",
    "worker:ritual": "node --env-file-if-exists=.env.local scripts/run-ritual-worker.mjs"
  },
  "dependencies": {
    "@edgeone/pages-blob": "^0.0.18",
    "lunar-javascript": "1.7.7"
  },
  "engines": {
    "node": ">=20.19 <25"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
